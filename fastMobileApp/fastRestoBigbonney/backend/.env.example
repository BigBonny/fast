# Server
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fast_resto?schema=public"

# JWT
JWT_SECRET="change-this-to-a-secure-random-string"
JWT_EXPIRES_IN="7d"

# CORS
CORS_ORIGIN="http://localhost:3000,http://localhost:5173"

# Stripe
STRIPE_SECRET_KEY="sk_test_or_live_key_here"
STRIPE_WEBHOOK_SECRET="whsec_optional_but_recommended"
STRIPE_CURRENCY="eur"
STRIPE_SUCCESS_URL="https://your-api.example.com/api/payments/checkout/success"
STRIPE_CANCEL_URL="https://your-api.example.com/api/payments/checkout/cancel"

# Upload (local dev)
UPLOAD_DIR="./uploads"

# Firebase Cloud Messaging (optional - push notifications)
# From Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
